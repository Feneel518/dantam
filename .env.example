# Copy to .env.local. Leave NODE_ENV unset here; Vercel supplies production.
PORT=3000
APP_URL=http://localhost:3000
# Production: set PostgreSQL. Local development uses a persistent SQLite file.
DATABASE_URL=
SQLITE_PATH=data/dantam.sqlite
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Dantam <hello@your-domain.in>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register APP_URL/api/google/callback as an OAuth redirect URI.
# Required for production authentication. Generate a separate random 32-byte secret.
BETTER_AUTH_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_GROWTH_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
# Messaging is configured independently by each clinic in its dashboard.
META_GRAPH_VERSION=v23.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
SUPPORT_EMAIL=
LEGAL_ENTITY=
LEGAL_ADDRESS=
# Run one or more separate workers. Queue claims are atomic.
WORKER_INTERVAL_MS=30000
# Vercel scheduled worker authorization (random 32+ character value).
CRON_SECRET=
# Comma-separated verified owner emails that may view platform adoption metrics.
PLATFORM_ADMIN_EMAILS=
# preview disables public registration and payments until provider/business setup.
LAUNCH_MODE=preview
# Private operator grant, applied only after email verification. Fixed ISO expiry;
# no payment, auto-renewal or repeated extension. Never expose as VITE_ variables.
COMPLIMENTARY_ACCESS_EMAILS=
COMPLIMENTARY_ACCESS_UNTIL=
# Set to 1 on Vercel so request limits use its forwarded client IP.
TRUST_PROXY=
